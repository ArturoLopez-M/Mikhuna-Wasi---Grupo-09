# Variables de entorno de las Lambdas (Terraform las define en cada función).
# Aquí solo van valores ficticios: nunca pongas secretos reales en este archivo.
NODE_ENV=development
# Instancia de escritura de Aurora a través de RDS Proxy. En local, la base de
# Docker (ver db/README.md). Contraseña ficticia de desarrollo.
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/mikhuna
# Instancia de lectura (endpoint de solo lectura de RDS Proxy). La usa Lectura
# y Configuración; si falta, lee de DATABASE_URL.
# DATABASE_READ_URL=postgresql://postgres:dev_password@localhost:5432/mikhuna
# ElastiCache (Redis). Sin ella no hay revisión de duplicados en caché, caché
# de lectura ni avisos en tiempo real; el sistema sigue funcionando.
# REDIS_URL=redis://localhost:6379
# URL de la etapa de API Gateway WebSocket (Pedidos, Cocina y Pagos la usan
# para avisar a las pantallas).
# WEBSOCKET_ENDPOINT=https://abc123.execute-api.us-east-2.amazonaws.com/dev
# Cognito: Lectura y Configuración valida el token al abrir el WebSocket. Sin
# estas dos variables no se acepta ninguna conexión. Valores ficticios.
# COGNITO_USER_POOL_ID=us-east-2_AbCdEf123
# COGNITO_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m
