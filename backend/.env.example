# Copia este archivo como .env y ajusta los valores.
# Aquí solo van valores ficticios: nunca pongas secretos reales en este archivo.
PORT=3000
NODE_ENV=development
# Base local en Docker (ver db/README.md). Contraseña ficticia de desarrollo.
DATABASE_URL=postgresql://postgres:dev_password@localhost:5432/mikhuna
# Cognito (opcional en local). Sin estas dos variables la API responde 401 a todo.
# Valores de ejemplo con formato ficticio; los reales salen de tu User Pool.
# COGNITO_USER_POOL_ID=us-east-2_AbCdEf123
# COGNITO_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m