# Configuración del frontend (Vite solo expone variables que empiezan con VITE_).
# Valores ficticios: los reales salen de Terraform al desplegar.
# URL de API Gateway REST (sin barra al final).
VITE_API_URL=https://abc123.execute-api.us-east-2.amazonaws.com/dev
# URL de API Gateway WebSocket.
VITE_WS_URL=wss://def456.execute-api.us-east-2.amazonaws.com/dev
# Cognito: región y App Client del User Pool (cliente público, sin secreto).
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_CLIENT_ID=1a2b3c4d5e6f7g8h9i0j1k2l3m
